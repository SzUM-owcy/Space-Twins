        "type": "object"
      },
      "MoonQuery": {
        "additionalProperties": false,
        "description": "Miejsce na Księżycu: ALBO ``site_id`` ALBO para ``lat`` + ``lon``.",
        "properties": {
          "lat": {
            "anyOf": [
              {
                "maximum": 90.0,
                "minimum": -90.0,
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Lat"
          },
          "lon": {
            "anyOf": [
              {
                "maximum": 180.0,
                "minimum": -180.0,
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Lon"
          },
          "site_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "examples": [
              "moon_apollo_11"
            ],
            "title": "Site Id"
          }
        },
        "title": "MoonQuery",
        "type": "object"
      },
      "MoonSite": {
