      },
      "Health": {
        "additionalProperties": false,
        "properties": {
          "custom_coordinates_available": {
            "description": "false, gdy na tej maszynie brak rastra LOLA: POST /analogs z lat/lon zwróci RASTER_UNAVAILABLE.",
