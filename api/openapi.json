{
  "components": {
    "schemas": {
      "Analog": {
        "additionalProperties": false,
        "properties": {
          "composition_confidence": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "high / medium / low / low_quartz_confounder (pewność proxy składu patch'a Ziemi).",
            "title": "Composition Confidence"
          },
          "composition_distance": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Composition Distance"
          },
          "composition_quality": {
            "anyOf": [
              {
                "enum": [
                  "good",
                  "moderate",
                  "poor"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Composition Quality"
          },
          "composition_status": {
            "anyOf": [
              {
                "enum": [
                  "ok",
                  "missing"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Composition Status"
          },
          "dominant_lithology": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Dominująca litologia podłoża (Macrostrat; mafic/felsic/anorthosite/carbonate/evaporite/sedimentary/unconsolidated/unknown). Tylko objaśnienie, nie wchodzi do wyniku.",
            "title": "Dominant Lithology"
          },
          "earth_mafic_felsic_percentile": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Earth Mafic Felsic Percentile"
          },
          "features": {
            "additionalProperties": {
              "type": "number"
            },
            "title": "Features",
            "type": "object"
          },
          "illumination_distance": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Illumination Distance"
          },
          "illumination_quality": {
            "anyOf": [
              {
                "enum": [
                  "good",
                  "moderate",
                  "poor"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Illumination Quality"
          },
          "illumination_status": {
            "anyOf": [
              {
                "enum": [
                  "ok",
                  "missing"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Illumination Status"
          },
          "lat": {
            "title": "Lat",
            "type": "number"
          },
          "lon": {
            "title": "Lon",
            "type": "number"
          },
          "mixed_lithology_flag": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "description": "True, gdy żadna klasa nie obejmuje >= 60% zmapowanych punktów łatki.",
            "title": "Mixed Lithology Flag"
          },
          "patch_id": {
            "title": "Patch Id",
            "type": "string"
          },
          "rank": {
            "title": "Rank",
            "type": "integer"
          },
          "region": {
            "title": "Region",
            "type": "string"
          },
          "region_name": {
            "title": "Region Name",
            "type": "string"
          },
          "shape_distance": {
            "title": "Shape Distance",
            "type": "number"
          },
          "slope_distance": {
            "title": "Slope Distance",
            "type": "number"
          },
          "source": {
            "enum": [
              "NASADEM",
              "COPDEM"
            ],
            "title": "Source",
            "type": "string"
          },
          "stability": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "description": "Ułamek przebiegów z szumem (stability_runs), w których łatka zostaje w top-K; null = nie liczone.",
            "title": "Stability"
          },
          "terrain_distance": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "description": "Tylko teren; ustawione, gdy w_thermal lub w_illum > 0.",
            "title": "Terrain Distance"
          },
          "terrain_quality": {
            "anyOf": [
              {
                "enum": [
                  "good",
                  "moderate",
                  "poor"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Etykieta składnika (odległość < 0.5 good, < 1.0 moderate, dalej poor); ustawiona razem z terrain_distance.",
            "title": "Terrain Quality"
          },
          "thermal_distance": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Thermal Distance"
          },
          "thermal_quality": {
            "anyOf": [
              {
                "enum": [
                  "good",
                  "moderate",
                  "poor"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Thermal Quality"
          },
          "thermal_status": {
            "anyOf": [
              {
                "enum": [
                  "ok",
                  "missing"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Thermal Status"
          },
          "total_distance": {
            "description": "Mniejsza = bardziej podobny teren.",
            "title": "Total Distance",
            "type": "number"
          },
          "z_scores": {
            "additionalProperties": {
              "type": "number"
            },
            "title": "Z Scores",
            "type": "object"
          }
        },
        "required": [
          "rank",
          "patch_id",
          "region",
          "region_name",
          "source",
          "lat",
          "lon",
          "slope_distance",
          "shape_distance",
          "total_distance",
          "features",
          "z_scores"
        ],
        "title": "Analog",
        "type": "object"
      },
      "AnalogsRequest": {
        "additionalProperties": false,
        "properties": {
          "feature_weights": {
            "anyOf": [
              {
                "additionalProperties": {
                  "type": "number"
                },
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "description": "Względne ważności 12 cech terenu (klucze = nazwy z /meta -> features, wartości >= 0; pominięte = 1). Zastępuje podział w_slope. null = domyślny schemat w_slope.",
            "examples": [
              {
                "elev_skew": 0,
                "rms_height": 2,
                "slope_p50": 3
              }
            ],
            "title": "Feature Weights"
          },
          "max_per_region": {
            "anyOf": [
              {
                "minimum": 1.0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": 1,
            "description": "Maks. łatek z jednego regionu w rankingu; null = bez limitu.",
            "title": "Max Per Region"
          },
          "moon": {
            "$ref": "#/components/schemas/MoonQuery"
          },
          "stability_runs": {
            "default": 0,
            "description": "Liczba przebiegów z szumem na cechach Księżyca (0 = wyłączone); wypełnia Analog.stability.",
            "maximum": 100.0,
            "minimum": 0.0,
            "title": "Stability Runs",
            "type": "integer"
          },
          "top_k": {
            "default": 5,
            "maximum": 50.0,
            "minimum": 1.0,
            "title": "Top K",
            "type": "integer"
          },
          "w_composition": {
            "default": 0.0,
            "description": "Waga składu mafic-felsic (proxy IR; percentyl w obrębie ciała); 0 = wyłączony. w_thermal + w_illum + w_composition <= 1.",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "W Composition",
            "type": "number"
          },
          "w_illum": {
            "default": 0.0,
            "description": "Waga oświetlenia (widoczność Słońca); 0 = wyłączone. w_thermal + w_illum <= 1.",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "W Illum",
            "type": "number"
          },
          "w_slope": {
            "default": 0.5,
            "description": "Waga nachyleń; (1 - w_slope) = waga kształtu.",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "W Slope",
            "type": "number"
          },
          "w_thermal": {
            "default": 0.0,
            "description": "Waga zakresu temperatur (percentyl); 0 = wyłączony (tylko teren).",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "W Thermal",
            "type": "number"
          }
        },
        "required": [
          "moon"
        ],
        "title": "AnalogsRequest",
        "type": "object"
      },
      "AnalogsResponse": {
        "additionalProperties": false,
        "properties": {
          "feature_weights": {
            "anyOf": [
              {
                "additionalProperties": {
                  "type": "number"
                },
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Feature Weights"
          },
          "max_per_region": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Max Per Region"
          },
          "moon": {
            "$ref": "#/components/schemas/MoonSummary"
          },
          "out_of_range": {
            "description": "Cechy Księżyca z |z| > out_of_range_z: ranking mniej wiarygodny - pokaż ostrzeżenie.",
            "items": {
              "type": "string"
            },
            "title": "Out Of Range",
            "type": "array"
          },
          "results": {
            "items": {
              "$ref": "#/components/schemas/Analog"
            },
            "title": "Results",
            "type": "array"
          },
          "top_k": {
            "title": "Top K",
            "type": "integer"
          },
          "w_composition": {
            "default": 0.0,
            "title": "W Composition",
            "type": "number"
          },
          "w_illum": {
            "default": 0.0,
            "title": "W Illum",
            "type": "number"
          },
          "w_slope": {
            "title": "W Slope",
            "type": "number"
          },
          "w_thermal": {
            "default": 0.0,
            "title": "W Thermal",
            "type": "number"
          }
        },
        "required": [
          "moon",
          "w_slope",
          "top_k",
          "max_per_region",
          "out_of_range",
          "results"
        ],
        "title": "AnalogsResponse",
        "type": "object"
      },
      "EarthRegion": {
        "additionalProperties": false,
        "properties": {
          "bbox": {
            "description": "[west, south, east, north] w stopniach.",
            "maxItems": 4,
            "minItems": 4,
            "prefixItems": [
              {
                "type": "number"
              },
              {
                "type": "number"
              },
              {
                "type": "number"
              },
              {
                "type": "number"
              }
            ],
            "title": "Bbox",
            "type": "array"
          },
          "dem": {
            "enum": [
              "nasadem",
              "copdem"
            ],
            "title": "Dem",
            "type": "string"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "patches": {
            "description": "Liczba łatek tego regionu w indeksie Ziemi.",
            "title": "Patches",
            "type": "integer"
          },
          "region": {
            "title": "Region",
            "type": "string"
          },
          "validation": {
            "description": "true = region z udokumentowanym analogiem księżycowym (walidacja).",
            "title": "Validation",
            "type": "boolean"
          }
        },
        "required": [
          "region",
          "name",
          "dem",
          "validation",
          "bbox",
          "patches"
        ],
        "title": "EarthRegion",
        "type": "object"
      },
      "ErrorResponse": {
        "additionalProperties": false,
        "description": "Każdy błąd (4xx/5xx) ma ten kształt.",
        "properties": {
          "code": {
            "enum": [
              "INVALID_REQUEST",
              "NOT_FOUND",
              "PATCH_REJECTED",
              "RASTER_UNAVAILABLE",
              "INTERNAL_ERROR"
            ],
            "title": "Code",
            "type": "string"
          },
          "details": {
            "anyOf": [
              {
                "items": {
                  "additionalProperties": true,
                  "type": "object"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "description": "Szczegóły walidacji (INVALID_REQUEST).",
            "title": "Details"
          },
          "message": {
            "description": "Komunikat czytelny dla człowieka (można pokazać w UI).",
            "title": "Message",
            "type": "string"
          }
        },
        "required": [
          "code",
          "message"
        ],
        "title": "ErrorResponse",
        "type": "object"
      },
